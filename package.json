{
  "name": "dagflow-frontend",
  "version": "1.0.0",
  "private": true,
  "homepage": "./",
  "main": "public/electron.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^2.6.0",
    "@json2csv/plainjs": "^7.0.6",
    "@lancedb/lancedb": "^0.4.0",
    "@seald-io/nedb": "^4.1.2",
    "adm-zip": "^0.5.10",
    "apache-arrow": "^14.0.0",
    "avsc": "^5.7.9",
    "axios": "^1.5.1",
    "chokidar": "^5.0.0",
    "node-cron": "^4.2.1",
    "openai": "^6.22.0",
    "parquetjs": "^0.11.2",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "react-scripts build && electron-builder",
    "dist:mac": "node scripts/ensure-mac-prebuilts.js && react-scripts build && electron-builder --mac",
    "dist:linux": "react-scripts build && electron-builder --linux",
    "dist:win": "react-scripts build && electron-builder --win",
    "dist:all": "react-scripts build && electron-builder --mac --linux --win",
    "pack:mac": "node scripts/ensure-mac-prebuilts.js && electron-builder --mac",
    "pack:linux": "electron-builder --linux",
    "pack:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.dagflux.app",
    "productName": "DagFlux",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sqlite3/**",
      "node_modules/@lancedb/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/pluginManager.js",
      "public/aiProviders.js",
      "public/analytics.js",
      "public/SqliteConnectionPool.js",
      "public/image/**/*",
      "public/imports/**/*",
      "public/joins/**/*",
      "public/lib/**/*",
      "public/NodeExecution/**/*",
      "public/transfomers/**/*",
      "public/triggers/**/*",
      "public/workflows/**/*",
      "plugins/**/*",
      "!**/*.map",
      "!**/*.log",
      "!**/.DS_Store",
      "!**/._*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "@ant-design/charts": "^2.6.6",
    "@ant-design/icons": "^5.2.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@googleworkspace/drive-picker-react": "^0.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^5.14.13",
    "@mui/material": "^5.14.13",
    "@mui/system": "^5.18.0",
    "@mui/x-data-grid": "^7.29.9",
    "@mui/x-date-pickers": "^6.20.2",
    "antd": "^5.10.2",
    "chart.js": "^4.4.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "html2canvas": "^1.4.1",
    "hyperformula": "^2.6.1",
    "jspdf": "^2.5.1",
    "moment": "^2.29.4",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-outside-click-handler": "^1.3.0",
    "react-router-dom": "^6.17.0",
    "react-scripts": "5.0.1",
    "reactflow": "^11.10.1",
    "wait-on": "^9.0.4"
  }
}
